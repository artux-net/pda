<?xml version="1.0" encoding="UTF-8"?>
<!--
    RoboVM/MobiVM packaging config.

    No <libs> section: as of gdx 1.12.1, gdx-platform/gdx-box2d-platform/gdx-freetype-
    platform's natives-ios jars ship prebuilt .xcframeworks plus their own
    META-INF/robovm/ios/robovm.xml fragment (<frameworks>gdx/gdx-box2d/gdx-freetype/
    ObjectAL</frameworks>), which the robovm gradle plugin merges in automatically from
    every dependency jar - confirmed by inspecting those jars directly (this file predates
    Xcode being available to verify the rest of the build end-to-end, see the README in
    this directory).
-->
<config>
    <executableName>PDA</executableName>
    <mainClass>net.artux.pda.ios.IOSLauncher</mainClass>
    <os>ios</os>
    <arch>arm64</arch>
    <target>ios</target>
    <iosInfoPList>Info.plist.xml</iosInfoPList>

    <resources>
        <resource>
            <directory>../assets</directory>
            <includes>
                <include>**</include>
            </includes>
        </resource>
        <!-- iOS-only resources the pda-assets submodule shouldn't carry (e.g. the flow's
             login banner, flow/banner.png) - merged into the same bundle root as ../assets. -->
        <resource>
            <directory>resources</directory>
            <includes>
                <include>**</include>
            </includes>
        </resource>
    </resources>

    <frameworks>
        <framework>UIKit</framework>
        <framework>OpenAL</framework>
        <framework>CoreGraphics</framework>
        <framework>Foundation</framework>
        <framework>CoreText</framework>
        <framework>QuartzCore</framework>
        <framework>MediaPlayer</framework>
        <framework>AVFoundation</framework>
        <!-- gdx-controllers-ios: unlike the natives-ios jars above, this one is a plain
             (pre-xcframework, 2021-dated) class jar with no bundled robovm.xml fragment -
             the frameworks its ObjC bridge classes need have to be listed here by hand. -->
        <framework>GameController</framework>
        <framework>CoreBluetooth</framework>
        <framework>CoreMotion</framework>
    </frameworks>

    <forceLinkClasses>
        <!-- Controllers.initialize() picks its platform manager with
             ClassReflection.forName(...) - never referenced directly in source, so RoboVM's
             dead-code stripping would otherwise drop it. -->
        <pattern>com.badlogic.gdx.controllers.**</pattern>
        <pattern>com.badlogic.gdx.scenes.scene2d.**</pattern>
        <!-- core (Gson-serialized QuestUtil.calculateDifference, MapStruct-mapped model
             classes) reflects over getters/setters that RoboVM's static analysis can't see
             are used, for the same reason. -->
        <pattern>net.artux.**</pattern>
        <!-- robovm-rt's own java/security/security.properties lists these 5 as
             security.provider.1-5, loaded only via Class.forName() from java.security.Security's
             static init - RoboVM's static analysis never sees that reflective load, so without
             this they're stripped and Security.getProviders() comes back empty at runtime. That
             breaks OkHttpClient's constructor immediately (FlowApiClient's first field init):
             OkHttp's Platform.isConscryptPreferred() does Security.getProviders()[0], which
             throws ArrayIndexOutOfBoundsException on an empty array before a single flow screen
             ever renders - confirmed on-device (:ios:launchIOSDevice on a real iPhone), not
             guessed. -->
        <pattern>com.android.org.conscrypt.**</pattern>
        <pattern>com.android.org.bouncycastle.**</pattern>
        <pattern>org.apache.harmony.security.provider.**</pattern>
    </forceLinkClasses>
</config>
